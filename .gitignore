# ─────────────────────────── Android / Gradle ───────────────────────────
*.iml
.gradle/
.kotlin/
build/
captures/
.externalNativeBuild/
.cxx/
local.properties
# Built app artifacts (regenerated by Gradle)
*.apk
*.aab
*.ap_
*.dex
release/
debug/

# ─────────────────────────── IDE / editor ───────────────────────────
.idea/
*.ipr
*.iws
.vscode/
*.swp
*~

# ─────────────────────────── OS junk ───────────────────────────
.DS_Store
Thumbs.db

# ─────────────────────────── Rust core ───────────────────────────
core/target/
# NB: core/Cargo.lock IS committed — this is a binary/app, so pinned deps
# give reproducible builds.

# ─────────────────────────── Build outputs (regenerated) ───────────────────────────
# Native library compiled by scripts/build-rust.sh
app/src/main/jniLibs/
# UniFFI-generated Kotlin bindings (regenerated by scripts/build-rust.sh)
app/src/main/java/app/light/wallet/core/

# ─────────────────────────── Secrets — NEVER commit ───────────────────────────
# Wallet material
*.pem
*.crt
*.gfs
mnemonic*.txt
seed*.txt
# Release signing
app/keystore.properties
keystore.properties
*.jks
*.keystore
# Logs / crash dumps that may contain runtime data
*.log
*.hprof
